rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /pdfs/{fileName} {
      // Original PDFs are served to public signers by /api/document. Direct
      // client access is restricted to the user recorded in object metadata.
      allow read: if request.auth != null
                  && resource.metadata.ownerUid == request.auth.uid;

      // New originals are uploaded by the authenticated owner. Requiring the
      // UID in custom metadata gives later read/delete rules a trusted owner.
      allow create: if request.auth != null
                    && request.resource.contentType == 'application/pdf'
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.metadata.ownerUid == request.auth.uid;

      // Signed files and lifecycle changes are written by Firebase Admin only.
      allow update: if false;

      allow delete: if request.auth != null
                    && resource.metadata.ownerUid == request.auth.uid;
    }
  }
}
