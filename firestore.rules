rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap access is tied to the Firebase-authenticated email. Existing
    // admins can additionally be represented by a locked user profile role.
    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'noam.hadad23@gmail.com'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'
        );
    }

    function ownsDocument(docId) {
      return signedIn()
        && get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid;
    }

    match /documents/{docId} {
      // The opaque UUID is the capability used by the public signing route.
      // Expiration is enforced here and is independently rechecked by /api/sign.
      allow get: if !('expiresAt' in resource.data)
                 || request.time.toMillis() < resource.data.expiresAt;

      allow list: if signedIn() && request.auth.uid == resource.data.clientId;

      allow create: if signedIn()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Signing lifecycle and file-result fields are server-owned. Document
      // owners may only rename records after creation; Firebase Admin performs
      // validated lifecycle updates and bypasses client rules.
      allow update: if ownsDocument(docId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['fileName']);
      allow delete: if ownsDocument(docId);

      match /markers/{markerId} {
        allow read: if !('expiresAt' in get(/databases/$(database)/documents/documents/$(docId)).data)
                    || request.time.toMillis()
                       < get(/databases/$(database)/documents/documents/$(docId)).data.expiresAt;
        allow write: if ownsDocument(docId);
      }
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && (
                      (request.auth.token.email == 'noam.hadad23@gmail.com'
                        && request.resource.data.role == 'superAdmin')
                      ||
                      (request.auth.token.email != 'noam.hadad23@gmail.com'
                        && request.resource.data.role == 'user')
                    );

      // A regular user cannot approve themselves or promote their own role.
      allow update: if isSuperAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['firstName', 'lastName']));
      allow delete: if isSuperAdmin();
    }

    match /logs/{logId} {
      allow create: if signedIn()
                    && request.resource.data.keys()
                      .hasAll(['actionType', 'timestamp', 'documentId'])
                    && request.resource.size < 2000;
      allow read: if signedIn();
    }
  }
}
