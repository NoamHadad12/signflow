# Public Firebase web configuration (bundled into the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only secrets (configure in Vercel; never expose with a VITE_ prefix)
GEMINI_API_KEY=
FIREBASE_STORAGE_BUCKET=

# Full Firebase service-account JSON, preferably base64-encoded in Vercel.
# Locally, GOOGLE_APPLICATION_CREDENTIALS may be used instead.
FIREBASE_SERVICE_ACCOUNT=
